// 供 Node.js 环境中通过转译或类型擦除运行的模块使用。
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    // 大多数工具使用转译，而非 Node.js 原生的类型擦除。
    // 使用打包器模式以便工具解析模块。
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // 仅包含 Node.js 类型，避免意外引入其他 @types 包。
    "types": ["node"],

    // vue-tsc --build 只用于类型检查，不生成输出文件。
    "noEmit": true,

    // vue-tsc --build 会生成用于增量类型检查的 .tsbuildinfo 文件。
    // 将它放在此目录，避免出现在项目根目录。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
