{
  "extends": "./tsconfig.app.json",

  // 仅包含测试文件，并清空排除项。
  // 测试导入的应用代码会通过模块解析自动纳入。
  "include": ["src/**/__tests__/*", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest 的运行环境与应用代码不同，因此单独设置 lib 和 types。
    "lib": [],
    "types": ["node", "jsdom"],

    // vue-tsc --build 会生成用于增量类型检查的 .tsbuildinfo 文件。
    // 将它放在此目录，避免出现在项目根目录。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
