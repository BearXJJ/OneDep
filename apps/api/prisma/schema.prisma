generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String?
  orcid        String?
  institution  String?
  country      String?
  passwordHash String
  role         Role         @default(SUBMITTER)
  depositions  Deposition[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Deposition {
  id          Int                @id @default(autoincrement())
  code        String             @unique
  method      DepositionMethod   @default(XRAY)
  methods     DepositionMethod[] @default([])
  status      DepositionStatus   @default(DRAFT)
  creation    Json               @default("{}")
  metadata    Json               @default("{}")
  profile     String?
  revision    Int @default(0)
  answers     Json @default("{}")
  origins     Json @default("[]")
  checks      Json @default("[]")
  snapshots   Submission[]
  submitterId Int
  submitter   User               @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  files       DepositionFile[]
  submittedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([submitterId, updatedAt])
}

model DepositionFile {
  id           Int                @id @default(autoincrement())
  depositionId Int
  deposition   Deposition         @relation(fields: [depositionId], references: [id], onDelete: Cascade)
  kind         DepositionFileKind
  slot         Int @default(1)
  revision     Int @default(1)
  active       Boolean @default(true)
  parseState   String @default("pending")
  parseError   String?
  parseResult  Json @default("{}")
  originalName String
  storedName   String
  mimeType     String
  size         Int
  checksum     String
  createdAt    DateTime           @default(now())

  @@unique([depositionId, kind, slot, revision])
  @@index([depositionId, active])
}

model Submission {
  id String @id
  depositionId Int @unique
  deposition Deposition @relation(fields: [depositionId], references: [id])
  snapshot Json
  exportName String
  checksum String
  createdAt DateTime @default(now())
}

enum Role {
  SUBMITTER
  REVIEWER
  ADMIN
}

enum DepositionMethod {
  XRAY
  EM
  NMR
  NEUTRON
  EC
  SSNMR
  FIBER
}

enum DepositionStatus {
  DRAFT
  SUBMITTED
}

enum DepositionFileKind {
  COORDINATE
  STRUCTURE_FACTOR
  EM_MAP
  EM_HALF_MAP
  EM_IMAGE
}
