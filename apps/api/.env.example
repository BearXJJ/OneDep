# 后期在 .env 中修改以下必填值；启动时逐项校验。
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://onedep:dev_password@127.0.0.1:5432/onedep?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
UPLOAD_DIR=uploads

# 后期可修改 Python 路径、任务超时和输出限制。相对路径以 apps/api 为基准。
ONEDEP_PYTHON=../../.local/python/Scripts/python.exe
GEMMI_TIMEOUT_MS=90000
GEMMI_MAX_OUTPUT_BYTES=4194304

# 仅创建管理员时填写。
ADMIN_NAME=管理员
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
