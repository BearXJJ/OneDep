# 后期在 .env 中修改以下必填值；启动时逐项校验。
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://onedep:dev_password@127.0.0.1:5432/onedep?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
UPLOAD_DIR=uploads

# 后期可修改 Python 路径、任务超时和输出限制。相对路径以 apps/api 为基准。
ONEDEP_PYTHON=../../.local/python/Scripts/python.exe
GEMMI_TIMEOUT_MS=90000
GEMMI_MAX_OUTPUT_BYTES=4194304

# 仅创建管理员时填写。
ADMIN_NAME=管理员
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# Copilot：后期在此修改模型端点、模型名、密钥和请求限制；全部必填。
# LLM_ENDPOINT 必须填写完整的 /chat/completions 地址，模型须支持 JSON Output。
LLM_ENDPOINT=https://api.gpt.ge/v1/chat/completions
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=60000

# Copilot 请求频率与预算：后期在此修改；代码不提供默认值。
COPILOT_IDLE_MS=8000
COPILOT_HINT_IDLE_MS=5000
COPILOT_DEBOUNCE_MS=1500
COPILOT_MIN_INTERVAL_MS=60000
COPILOT_CACHE_TTL_SECONDS=900
COPILOT_DAILY_REQUEST_LIMIT=40
COPILOT_GLOBAL_DAILY_REQUEST_LIMIT=200
COPILOT_MAX_INPUT_CHARS=24000
COPILOT_AUTO_ENABLED=true
