# 复制为 .env.production；以下配置可在后期按运行机器修改，缺项直接报错。
# 填写随机十六进制数据库密码，例如 openssl rand -hex 24。
POSTGRES_PASSWORD=

# 当前分支本地构建的镜像名称；后期使用已发布镜像时改为对应地址和版本。
ONEDEP_API_IMAGE=onedep-api:local
ONEDEP_WEB_IMAGE=onedep-web:local

# 容器内 Python 路径，与 Dockerfile 的虚拟环境位置对应。
ONEDEP_PYTHON=/opt/onedep-python/bin/python
GEMMI_TIMEOUT_MS=90000
GEMMI_MAX_OUTPUT_BYTES=4194304

# 后期可修改监听地址、端口；默认配置只在本机访问 http://127.0.0.1:8080。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# 在仓库根目录依次运行；第一条构建当前检出分支，第二条迁移并启动。
# docker compose --env-file .env.production -f compose.production.yml build
# docker compose --env-file .env.production -f compose.production.yml up -d --wait --no-build --pull missing
# 上传文件与数据库保存在命名卷中，停机使用 down，保留这些卷。
# docker compose --env-file .env.production -f compose.production.yml down

# StepAlong：后期在此修改模型端点、模型名、密钥和请求限制；全部必填。
# LLM_ENDPOINT 必须填写完整的 /responses 地址，模型须支持 JSON schema 输出。
LLM_ENDPOINT=https://api.openai.com/v1/responses
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=60000
